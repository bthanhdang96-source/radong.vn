{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/gia-nong-san/:commoditySlug/:locationSlug",
      "destination": "https://radongvn-production.up.railway.app/gia-nong-san/:commoditySlug/:locationSlug"
    },
    {
      "source": "/gia-nong-san/:commoditySlug",
      "destination": "https://radongvn-production.up.railway.app/gia-nong-san/:commoditySlug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap-price-pages.xml",
      "destination": "/api/sitemap-price-pages"
    },
    {
      "source": "/sitemap-commodity-price-pages.xml",
      "destination": "/api/sitemap-commodity-price-pages"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
